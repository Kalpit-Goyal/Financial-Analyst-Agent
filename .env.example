# Backend environment variables
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://financial-analyst-agent2.vercel.app

# MCP Server (optional - uses streamable-http with stdio fallback)
MCP_HOST=127.0.0.1
MCP_PORT=8931
MCP_STARTUP_TIMEOUT=20

# Financial tool settings
FIN_TOOL_PERIODS=8
FIN_TOOL_CACHE_TTL=900
FIN_TOOL_RETRY_BACKOFF=3
FIN_TOOL_CURRENCY_CACHE_TTL=60

# ---- Autonomous monitor (all optional; the chat works without them) ----

# Database for accounts, chat history, the watchlist and alert history. Use a free
# Postgres (e.g. Neon) so data survives redeploys. Without it the app falls back to a
# local SQLite file, which is wiped on most free hosts. Use the same value in Render
# and in the GitHub secret.
DATABASE_URL=

# How long a sign-in session stays valid (days). Sessions are stored in the database.
# AUTH_SESSION_DAYS=30

# Telegram alerts. Create a bot with @BotFather, then message it and read your chat id.
# If either is empty, alerts are only written to the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: use a different (e.g. smaller) model for triage, composing and fact-checking.
# MONITOR_GROQ_MODEL=

# Optional tuning (defaults shown)
# MONITOR_MOVE_1D_PCT=4
# MONITOR_MOVE_5D_PCT=8
# MONITOR_EARNINGS_DAYS=3
# MONITOR_COOLDOWN_HOURS=24
# MONITOR_MAX_INVESTIGATIONS=3
# MONITOR_MAX_REVISIONS=2
# MONITOR_OUTCOME_DAYS=7
