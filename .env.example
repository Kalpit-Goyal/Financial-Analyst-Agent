# Backend environment variables
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://financial-analyst-agent2.vercel.app

# MCP Server (optional - defaults to stdio transport)
MCP_HOST=127.0.0.1
MCP_PORT=8931
MCP_TRANSPORT=stdio