GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
LANGSMITH_API_KEY=langsmith-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=financial-analyst
RENDER_API_KEY=your-render-api-key-here

# MCP financial tool server (used by the backend to launch the tool server)
MCP_HOST=127.0.0.1
MCP_PORT=8931
MCP_STARTUP_TIMEOUT=20

# Financial tool behaviour
FIN_TOOL_PERIODS=8
FIN_TOOL_CACHE_TTL=900
FIN_TOOL_RETRY_BACKOFF=3

# Backend
BACKEND_URL=http://localhost:8000
KEEP_ALIVE_INTERVAL=300
